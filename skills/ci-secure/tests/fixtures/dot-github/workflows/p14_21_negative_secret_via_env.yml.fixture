# Negative-lookalike fixture for P14.21 — the SAME secret, passed the
# safe way: bound to a step env var, referenced as a quoted shell var in
# the run block. The `${{ secrets.* }}` expression appears only in the
# env: block, which the yaml-run-injection detector structurally excludes.
#
# Scanner expectation: zero P14.21 findings on this file.

name: deploy
on:
  push:
    branches: [main]

permissions: {}

jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - env:
          DEPLOY_TOKEN: ${{ secrets.DEPLOY_TOKEN }}
        run: ./deploy.sh --token="$DEPLOY_TOKEN"
