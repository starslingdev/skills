# Fixture for P14.12 — long-lived cloud / publish credentials.
# References AWS, GCP, and npm long-lived tokens directly in secrets.
# Fires once per distinct credential reference.

name: deploy

on:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@a5ac7e51b41094c92402da3b24376905380afc29
      - name: Configure AWS (long-lived)
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        run: aws sts get-caller-identity
      - name: Publish to npm (long-lived)
        env:
          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}
        run: npm publish
