# Positive fixture for P14.19 — a cache step whose `path:` is a credential
# file (~/.aws/credentials). Anyone restoring the cache key downloads the
# AWS credentials directly, across any trust boundary the key is shared
# with.
#
# Scanner expectation: one P14.19 finding.

name: ci
on:
  push:
    branches: [main]

permissions: {}

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/cache@0c45773b623bea8c8e75f6c82b208c3cf94ea4f9
        with:
          path: ~/.aws/credentials
          key: creds-${{ runner.os }}
