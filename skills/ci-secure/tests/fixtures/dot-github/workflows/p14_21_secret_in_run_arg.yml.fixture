# Positive fixture for P14.21 — a secret interpolated directly into a
# `run:` command argument. The secret lands in the process argv and, on
# error, possibly the run log. Uses a generic secret name (not one of
# P14.12's publish-credential names) so this fixture isolates P14.21.
#
# Scanner expectation: one P14.21 finding on the run: line.

name: deploy
on:
  push:
    branches: [main]

permissions: {}

jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - run: ./deploy.sh --token=${{ secrets.DEPLOY_TOKEN }}
